# Copy to .env.local (dev) or .env (compose) and fill in.

# https://console.x.com — app must be in a Project with API access
X_BEARER_TOKEN=
X_CONSUMER_KEY=
X_SECRET_KEY=

# https://jina.ai/?sui=apikey — enrich.py bodies + chat web_scrape / web_search
JINA_API_KEY=

# Optional. When set, Sources UI mutations require Authorization: Bearer <token>.
# Leave empty for open local laptop use; set it if the app is reachable beyond localhost.
NEWS_ADMIN_TOKEN=

# Optional local news assistant providers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
# Optional alternate live-web backend when JINA_API_KEY is unset.
FIRECRAWL_API_KEY=
LOCAL_CHAT_USER_ID=local
CHAT_STORAGE_DIR=
WEB_SEARCH_MAX_USES=5
